+_FP16_MAX = torch.finfo(torch.float16).max
+
+
+def _fp16_partial_linear(
+    x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor | None, scale: float
+) -> torch.Tensor:
+    """BF16 x @ weight.T, times ``scale`` (a power of two), rounded to FP16.
+
+    cuBLAS accumulates in FP32 either way; the FP32 result is rounded once to
+    FP16 (2^-11 relative) instead of BF16 (2^-8). torch.mm only offers FP32 as
+    the wider output dtype for BF16 inputs, hence the explicit conversion.
+    Values beyond the FP16 range saturate instead of becoming inf.
+    """
+    out = torch.mm(x.reshape(-1, x.shape[-1]), weight.t(), out_dtype=torch.float32)
+    if bias is not None:
+        out = out + bias.float()
+    if scale != 1.0:
+        out = out * scale
+    out = out.clamp(-_FP16_MAX, _FP16_MAX).to(torch.float16)
+    return out.view(*x.shape[:-1], weight.shape[0])
+
+
